{
  "name": "waywise-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:dev": "npm --prefix api run dev",
    "api:build": "npm --prefix api run build",
    "api:test": "npm --prefix api test",
    "api:typecheck": "npm --prefix api run typecheck",
    "api:migrate": "npm --prefix api run migrate"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "mapbox-gl": "^3.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  }
}
