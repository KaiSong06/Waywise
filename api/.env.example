NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Local development can use the Docker Compose PostGIS database.
DATABASE_URL=postgres://waywise:waywise@localhost:54329/waywise

# Cloud Run + Cloud SQL can use socket settings instead of DATABASE_URL.
DB_USER=waywise
DB_PASSWORD=change-me
DB_NAME=waywise
CLOUD_SQL_CONNECTION_NAME=project:region:instance
DATABASE_SOCKET_PATH=/cloudsql

CORS_ORIGINS=http://localhost:5173,https://your-dashboard.vercel.app
DEMO_MODE=true
AUTO_SEED_DEMO=false
CLUSTERING_RADIUS_METERS=20
DUPLICATE_WINDOW_SECONDS=30
MAX_GPS_ACCURACY_METERS=50
